# Deployment adapter only. Obtain the exact HTTPS endpoint/headers from your ARMS workspace.
# The endpoint may itself contain a write credential; keep this entire file private.
DEERMATE_TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://replace-from-console.invalid
# CloudMonitor 2.0 workspace example. Copy the actual header names/values from your console.
OTEL_EXPORTER_OTLP_HEADERS=x-arms-license-key=replace-license-key,x-arms-project=replace-project,x-cms-workspace=replace-workspace
# Older ARMS workspaces may instead provide Authentication and a complete traces URL.
# Use that exact profile rather than combining header formats or guessing a path.
OTEL_TRACES_SAMPLER=parentbased_always_on
